        width: 1616,
        height: 1083,
      },
      thumbnail: {
        src: gal01,
        alt: 'Naši dobrovolníci jsou vždy připraveni poradit',
      },
    },
  ],
  [
    {
      original: {
        href: 'https://lh3.googleusercontent.com/pw/AP1GczMbXg2YW2k3mZ41YgCIeZEDPd_Kv_l8LRHH0O_to1XQGT6fNeNd3km-DMEKH8cJrLaON-10ZMndGywgh3ZzATfktDVQf8kfx2gxbMy7uBIeCynDoqh_RZnmMo00Xz7mF8yfYjpzqpig47JGIFOV_K4q=w1616-h1083-s-no-gm',
        width: 1616,
        height: 1083,
      },
      thumbnail: {
        src: gal02,
        alt: 'Prezence na startu Provodínské Štrapandy 2025',
      },
    },
    {
      original: {
        href: 'https://lh3.googleusercontent.com/pw/AP1GczPiduSAhh5h1ox2CzD_ht9ZJ_yareAMtXDH0ZedkcwShlw_NUv0bSgZquIgVCz1cTc3T6Zf1bNwGPrC7GVbn7qQCCxPFBtXc43SbBb2cJ44hQu-nJuxAzrih4OtsksF9ctQp6Se1xxhUuqTO_KljbRo=w1616-h1083-s-no-gm',
        width: 1616,
        height: 1083,
      },
      thumbnail: {
        src: gal03,
        alt: 'K Provodínské Štrapandě tradičně patří i výborné jídlo',
      },
    },
  ],
  [
    {
      original: {
        href: 'https://lh3.googleusercontent.com/pw/AP1GczPyJwEj80sC2RGrJvZlmop1kAIC8rH37EiNPVEB3ZXARtbCEvIhzX-OMDAI_sYmXgDXa86QEGyrToz_u3Adzy_zoqsl448inqiwHyWbjl656Qliw4bOqHPk-YZ3LSH447E7qj7-b-gsFKpOlBsdmIiO=w1083-h1616-s-no-gm',
        width: 1083,
        height: 1616,
      },
      thumbnail: {
        src: gal04,
        alt: 'Jan Piškula, starosta Provodína, bez kterého by Štrapanda nebyla',
      },
    },
    {
      original: {
        href: 'https://lh3.googleusercontent.com/pw/AP1GczNewQnIvS9Amgd6qMHCP8TFc58nXNaToMNYhCJvHHlN6z2BxpVb7kFtAtYS4VL9datMBR1BHpphIRHRCH-IKp3TrZale9Ix5dTx1r5rbgNZqpHdm1lDF3dWTOZrms9ZhBPR6SQ9g9p2OYhRSxPW4ib9=w1616-h1616-s-no-gm',
        width: 1616,
        height: 1616,
      },
      thumbnail: {
        src: gal05,
        alt: 'V cíli bylo o zábavu postaráno',
